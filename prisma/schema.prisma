// Finanzas — esquema de datos

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  /// Momento en que el usuario confirmó su email con el código de 6 dígitos.
  /// Null = aún no verificado.
  emailVerified DateTime?
  /// Si recibe el resumen diario de alertas por correo (cron).
  emailAlertsEnabled Boolean @default(true)
  /// Foto de perfil como data URL (base64), redimensionada en el cliente
  /// antes de subir. No usamos almacenamiento externo por ahora.
  image         String?   @db.Text
  createdAt     DateTime  @default(now())

  accounts         Account[]
  debts            Debt[]
  cardCharges      CardCharge[]
  recurringItems   RecurringItem[]
  transactions     Transaction[]
  assets           Asset[]
  investments      Investment[]
  goals            Goal[]
  goalContributions GoalContribution[]
  netWorthSnapshots NetWorthSnapshot[]
  verificationCodes VerificationCode[]
}

enum VerificationCodeType {
  EMAIL_VERIFY
  PASSWORD_RESET
  /// Token opaco emitido tras verificar el código de PASSWORD_RESET, para el
  /// paso final de "escribir la nueva contraseña" sin heredar la vigencia
  /// corta del código de 6 dígitos (ver src/lib/verification-code.ts).
  PASSWORD_RESET_CONFIRMED
}

/// Código numérico de 6 dígitos de un solo uso, enviado por correo, para
/// verificar el email o para autorizar un cambio de contraseña olvidada.
model VerificationCode {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       VerificationCodeType
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([userId, type])
}

enum AccountType {
  SAVINGS
  CHECKING
  CASH
}

/// Cuenta bancaria (ahorros/corriente) o efectivo: de aquí entran los ingresos
/// (pagos de nómina, alquiler de la moto) y de aquí salen los pagos/retiros.
model Account {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  bank      String?
  type      AccountType @default(SAVINGS)
  balance   Decimal     @default(0) @db.Decimal(14, 2)
  currency  String      @default("COP")
  exchangeRateToCOP Decimal? @db.Decimal(16, 4)
  /// Tasa efectiva anual que paga la cuenta por mantener el dinero ahí
  /// (rendimientos de ahorro). Null/0 = no genera interés.
  interestRateEA Decimal? @db.Decimal(7, 4)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactions Transaction[]

  @@index([userId])
}

enum DebtType {
  CARD
  LOAN
}

model Debt {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  creditor       String
  balance        Decimal   @db.Decimal(14, 2)
  interestRateEA Decimal   @db.Decimal(7, 4)
  minPayment     Decimal   @db.Decimal(14, 2)
  creditLimit    Decimal?  @db.Decimal(14, 2)
  currency       String    @default("COP")
  exchangeRateToCOP Decimal? @db.Decimal(16, 4)
  type           DebtType  @default(CARD)
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transactions Transaction[]
  cardCharges  CardCharge[]

  @@index([userId])
}

/// Una compra hecha con una tarjeta de crédito, con su propio plan de cuotas
/// (puede ser distinto al de otras compras en la misma tarjeta: 0% de interés
/// en una promoción, X cuotas en otra, etc). El saldo de la tarjeta (Debt.balance)
/// se mantiene como la suma de los saldos restantes de sus compras activas.
model CardCharge {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debtId            String
  debt              Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  description       String
  category          String
  purchaseDate      DateTime @default(now())
  originalAmount    Decimal  @db.Decimal(14, 2)
  remainingBalance  Decimal  @db.Decimal(14, 2)
  installmentsCount Int
  installmentsPaid  Int      @default(0)
  interestRateEA    Decimal  @db.Decimal(7, 4)
  monthlyPayment    Decimal  @db.Decimal(14, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions Transaction[]

  @@index([userId])
  @@index([debtId])
}

enum RecurringFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
  YEARLY
}

enum RecurringType {
  INCOME
  EXPENSE
}

model RecurringItem {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String
  amount    Decimal            @db.Decimal(14, 2)
  frequency RecurringFrequency @default(MONTHLY)
  type      RecurringType
  active    Boolean            @default(true)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  transactions Transaction[]

  @@index([userId])
}

enum TransactionType {
  INCOME
  EXPENSE
  DEBT_PAYMENT
  CARD_CHARGE
  TRANSFER
  SAVINGS
}

enum Quincena {
  Q1
  Q2
}

model Transaction {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  quincena        Quincena
  amount          Decimal          @db.Decimal(14, 2)
  type            TransactionType
  category        String
  notes           String?
  debtId          String?
  debt            Debt?            @relation(fields: [debtId], references: [id], onDelete: SetNull)
  cardChargeId    String?
  cardCharge      CardCharge?      @relation(fields: [cardChargeId], references: [id], onDelete: SetNull)
  accountId       String?
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  recurringItemId String?
  recurringItem   RecurringItem?   @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@index([userId, date])
}

enum AssetType {
  VEHICLE
  PROPERTY
  INVESTMENT
  OTHER
}

model Asset {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AssetType
  estimatedValue Decimal   @db.Decimal(14, 2)
  /// % anual de valorización (positivo) o depreciación (negativo) para
  /// proyecciones. Si es null, se usa el valor por defecto según `type`
  /// (vehículos: -20%/año recta según vida útil DIAN; inmuebles: +4%/año).
  annualRatePercent Decimal? @db.Decimal(7, 4)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

enum InvestmentType {
  STOCK
  ETF
  CRYPTO
  FUND
  REAL_ESTATE
  OTHER
}

model Investment {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         InvestmentType
  quantity     Decimal        @db.Decimal(18, 6)
  avgCost      Decimal        @db.Decimal(14, 2)
  currentPrice Decimal        @db.Decimal(14, 2)
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())

  @@index([userId])
}

enum GoalType {
  EMERGENCY_FUND
  DEBT_FREE
  NET_WORTH
  CUSTOM
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  type          GoalType
  targetAmount  Decimal  @db.Decimal(14, 2)
  currentAmount Decimal  @default(0) @db.Decimal(14, 2)
  targetDate    DateTime?
  /// Meses elegidos para alcanzar la meta (para calcular la cuota fija
  /// sugerida); independiente de targetDate, que es solo informativa.
  targetMonths  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contributions GoalContribution[]

  @@index([userId])
}

/// Un abono/aporte individual a una meta — permite ver el desglose de cómo
/// se fue construyendo el ahorro en vez de solo un número editado a mano.
model GoalContribution {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  @@index([goalId])
}

model NetWorthSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  totalAssets  Decimal  @db.Decimal(16, 2)
  totalDebts   Decimal  @db.Decimal(16, 2)
  netWorth     Decimal  @db.Decimal(16, 2)

  @@index([userId, date])
}
